    "words": [
      {
        "index": 0,
        "name": "target",
        "meaning": "Param id the knob edits. Factory voice effects use 0x41000001, 0x41000002, 0x41040000 or 0x41080000. Vocal presets use 0x41000001/0x41000002, distortion presets use 0x41040000, chorus and reverb presets use 0x41080000. The live word is 0x01050000, the LGlobalSettings id, so a target outside the 0x41 family is possible.",
        "confidence": "observed"
      },
      {
        "index": 1,
        "name": "mask",
        "meaning": "Bits the knob changes. Voice effects use 0x7F, 0x7E or 0x7F0000; chorus presets use 0x7F00. Word 2 and word 3 always sit inside these bits, and word 2 <= word 3. That mask reading is not confirmed on the device.",
        "confidence": "inferred"
      },
      {
        "index": 2,
        "name": "low",
        "meaning": "Low end of the knob, in the same bits as word 1. Unconfirmed.",
        "confidence": "inferred"
      },
      {
        "index": 3,
        "name": "high",
        "meaning": "High end of the knob, in the same bits as word 1. Unconfirmed.",
        "confidence": "inferred"
      }
