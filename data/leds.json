  "palette_source": "MA::LAppEngine::InitColorArrays (Panel), index = MIDI colour value; 0 and 1 are both black",
  "modes": {
    "note": "Button V1 and array word 0 are packed words; the byte layout is inferred from presets, not verified on hardware.",
    "button_v1": {
      "0x00000000": {
        "name": "static",
        "confidence": "inferred",
        "desc": "solid: active colour while pressed/lit, idle colour otherwise"
      },
      "0x00010000": {
        "name": "static (variant, byte2=1)",
        "confidence": "inferred"
      },
      "0x00020000": {
        "name": "rainbow (byte2=2)",
        "confidence": "inferred"
      },
      "0x00020002": {
        "name": "rainbow, byte0=2",
        "confidence": "inferred"
      }
    },
    "ui_effect_names": [
      "SOLID",
      "PULSE (1-4 colours)",
      "RAINBOW (bright/dark 1-2/default)",
      "CHASING",
      "VU",
      "VU_WITH_PEAK",
      "FADER (1-2 colours, indicator, background)",
      "GRADIENT_FADER",
      "CHASING_FADER",
      "PULSE_FADER",
      "RAINBOW_FADER"
    ],
    "ui_effect_names_note": "Strings NID_LED_SETTINGS_* in the Panel; their numeric order in the V1 word is NOT established.",
    "array_word0": {
      "note": "Words seen: 0x04|(i<<24) (Default, static), 0x02, 0x00, 0x06|(i<<24), 0x140003 (Rainbow), 0x140001 (Pulse/VU on arrays 7-8), 0x1E0D38|(i<<24) (Pulse and VU, bytes 38 0D 1E = same shape as live device reading 0x051E0D18). byte3 looks like a per-array index; byte0..2 effect/variant. Exact meaning unverified."
    },
    "colour_fields": "button V2/V3 are palette indices 0..127 (bit7 unused). Observed V3 = V2 + 0x32 for solid colours: V2 is the dim (0x55-scaled) twin of V3's full-brightness colour. Which of V2/V3 is shown when lit vs idle is unverified; contract names are active=V2, idle=V3."
  }
